# Guest injection binary (built from the instantCLI checkout by run.sh)
/assets/ins

# Prepared running-OS host disk images for the --host-arch / --host-ubuntu
# flows (tools/mkhost-arch.sh, tools/mkhost-ubuntu.sh). Large binaries built
# from docker base images; never commit them — the builders are the source.
# By default they land in $E2E_WORK_DIR/images (../e2e-work/images), i.e.
# outside this repository; these patterns only bite if someone points
# E2E_IMAGE_DIR at the checkout, which run.sh allows.
*.img
*.img.env
arch-host/
ubuntu-host/

# isotovideo runtime state, written into the directory the casedir runs from
# (casedir/ for the main suite, diag/*/ for the offline harnesses —
# unanchored on purpose so this one list covers them all)
autoinst-status.json
backend.run
base_state.json
command-server-tmp/
os-autoinst.pid
qemu.pid
qemu_state.json
qemuscreenshot/
qmp_socket.log
raid/
serial0
testresults/
ulogs/
vars.json
video.ogv
video_time.vtt
virtio_console.log
virtio_console_user.log
*.qcow2
__pycache__/
run*.log
