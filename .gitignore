backend.run
base_state.json
command-server-tmp/
os-autoinst.pid
qemu.pid
qemu_state.json
qemuscreenshot/
qmp_socket.log
raid/
serial0
testresults/
ulogs/
vars.json
video.ogv
video_time.vtt
virtio_console.log
virtio_console_user.log
*.qcow2
__pycache__/
run*.log
